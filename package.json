{
  "name": "divya-motel-room-condition",
  "version": "1.0.0",
  "private": true,
  "description": "Divya Motel - Room Condition / Preventive Maintenance Program",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:deploy": "prisma generate && prisma db push && prisma db seed && tsx scripts/ensure-storage-bucket.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "storage:ensure-bucket": "tsx scripts/ensure-storage-bucket.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "cuid": "^3.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "0.456.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cuid": "^1.3.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.13",
    "typescript": "5.6.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
